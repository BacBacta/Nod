# Nod attestation service. Copy to .env (never commit it).
PORT=8787
# Public URL of this service; OAuth redirect URIs are <PUBLIC_URL>/v1/oauth/<platform>/callback
PUBLIC_URL=https://attest.example.com
# Frontend URL: CORS origin, Sign In With Farcaster domain, post-OAuth redirect
FRONTEND_URL=https://app.example.com

# Arc Testnet
RPC_URL=https://rpc.testnet.arc.io
CHAIN_ID=5042002
ATTESTOR_ADDRESS=
# Key holding ATTESTER_ROLE on IdentityAttestor. Local/testnet only: use a KMS or a
# Circle developer-controlled wallet in production.
ATTESTER_PRIVATE_KEY=

# Farcaster (Sign In With Farcaster). Optimism RPC used to check FID keys.
FARCASTER_ENABLED=true
OPTIMISM_RPC_URL=https://mainnet.optimism.io

# A platform is enabled only when both values are set.
X_CLIENT_ID=
X_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
